# Required for real AI shortcut matching on Vercel Functions
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Keep defaults unless you know you want another Gemini model/API version.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_VERSION=v1beta

# Optional. Protects Gemini quota. Set to 0 to disable.
SEARCH_RATE_LIMIT_PER_MINUTE=20
SEARCH_RATE_LIMIT_WINDOW_MS=60000

# Optional Formula Finder AI limit. Uses GEMINI_API_KEY / GOOGLE_API_KEY above.
FORMULA_AI_RATE_LIMIT_PER_MINUTE=10
FORMULA_AI_RATE_LIMIT_WINDOW_MS=60000
